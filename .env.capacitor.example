# Capacitor WebView server URL — copy to .env.capacitor (gitignored).
# Used only when running: npx cap sync
#
# Omit CAPACITOR_SERVER_URL for production store builds (bundled boot + live redirect).
#
# iOS Simulator (local dev):
# CAPACITOR_SERVER_URL=http://localhost:4200
#
# Android Emulator (local dev):
# CAPACITOR_SERVER_URL=http://10.0.2.2:4200
#
# Physical device on LAN (use your machine IP):
# CAPACITOR_SERVER_URL=http://192.168.1.100:4200
