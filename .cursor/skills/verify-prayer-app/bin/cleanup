#!/usr/bin/env bash
# Tear down the ng serve instance this run started. Never kills by process name.
# Usage: bin/cleanup
# Evidence under artifacts/<run-id>/ is kept.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

if [[ ! -f "$PID_FILE" ]]; then
  echo "No pid file at ${PID_FILE}. Nothing to stop."
  print_instance
  echo "Evidence (if any) remains at ${EVIDENCE_DIR}"
  exit 0
fi

pid="$(cat "$PID_FILE" 2>/dev/null || true)"
if [[ -z "${pid}" ]]; then
  echo "Empty pid file. Removing ${PID_FILE}."
  rm -f "$PID_FILE"
  exit 0
fi

if ! kill -0 "$pid" 2>/dev/null; then
  echo "Pid ${pid} is not running. Removing stale pid file."
  rm -f "$PID_FILE"
  echo "Evidence remains at ${EVIDENCE_DIR}"
  exit 0
fi

echo "Stopping ng serve pid ${pid} (run ${PRAYER_APP_VERIFY_RUN_ID})"
kill "$pid" 2>/dev/null || true
for _ in $(seq 1 20); do
  if ! kill -0 "$pid" 2>/dev/null; then
    break
  fi
  sleep 0.25
done
if kill -0 "$pid" 2>/dev/null; then
  echo "Pid ${pid} still alive; sending SIGKILL"
  kill -9 "$pid" 2>/dev/null || true
fi

# ng serve often leaves a child node; only kill children of the recorded pid.
if command -v pgrep >/dev/null 2>&1; then
  children="$(pgrep -P "$pid" || true)"
  if [[ -n "${children}" ]]; then
    echo "$children" | xargs -r kill 2>/dev/null || true
  fi
fi

rm -f "$PID_FILE"
echo "Stopped. Instance scratch ${STATE_DIR} may remain; evidence is at ${EVIDENCE_DIR}"
print_instance
