{
  "name": "prayerapp",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lan": "ng serve --host 0.0.0.0",
    "build": "node scripts/write-prod-environment.mjs && ng build",
    "build:dev": "ng build --configuration development",
    "build:prod": "node scripts/write-prod-environment.mjs && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage && node scripts/coverage-report.js",
    "lint": "echo 'Lint is disabled: angular.json has no lint target, and eslint.config.js is a React leftover whose plugins are not installed. CI does not run lint.' >&2 && exit 1",
    "cap:icons": "cp public/apple-touch-icon.png resources/logo.png && npx @capacitor/assets generate --iconBackgroundColor '#1a365d' --iconBackgroundColorDark '#1a365d' --splashBackgroundColor '#1a365d' --splashBackgroundColorDark '#1a365d' && cp icons/icon-*.webp public/icons/",
    "cap:icons:generate": "npx @capacitor/assets generate --iconBackgroundColor '#1a365d' --iconBackgroundColorDark '#1a365d' --splashBackgroundColor '#1a365d' --splashBackgroundColorDark '#1a365d'",
    "cap:sync": "npx cap sync",
    "cap:sync:prod": "npm run build:prod && npx cap sync",
    "cap:open": "npx cap open ios",
    "cap:dev": "npx cap sync",
    "cap:prod": "npm run cap:sync:prod",
    "resize-app-store-screenshots": "node scripts/resize-app-store-screenshots.js"
  },
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/cdk-experimental": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capawesome/capacitor-badge": "^8.0.3",
    "@capgo/capacitor-printer": "^8.1.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.11",
    "driver.js": "^1.8.0",
    "marked": "^18.0.13",
    "posthog-js": "^1.434.2",
    "rxjs": "^7.8.2",
    "tiptap-markdown": "^0.9.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
