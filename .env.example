# Supabase Configuration (frontend — Vite)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Example:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_... (Dashboard → Settings → API Keys → publishable)

# Server-side only (e.g. process-email-queue, restore/backup workflows — never bundle into the Angular app)
# Supabase Dashboard → Settings → API Keys → Secret (sb_secret_...). Prefer this over the legacy service_role JWT.
# SUPABASE_SECRET_KEY=sb_secret_...

# Public site URL (links in emails, Capacitor, production builds)
# VITE_APP_URL=https://prayer.romans8.net

# Host-based tenancy (production / staging)
# VITE_PLATFORM_HOSTS=prayer.romans8.net,prayerapp.romans8.net
# VITE_COOKIE_PARENT_DOMAIN=.prayer.romans8.net
# VITE_TENANT_HOST_SUFFIX=prayer.romans8.net

# PostHog (product analytics, session replay, error tracking — optional)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_UI_HOST=https://us.posthog.com
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_SENDER_ADDRESS=noreply@your-verified-domain.com
# MAIL_FROM_NAME=Prayer Ministry
# Per-tenant From name / local-part live on tenant_settings (Admin → Email → Sending identity).
# They always use the domain of MAIL_SENDER_ADDRESS; custom domains are later.

# Stripe (Supabase Edge Function secrets only — never bundle into the Angular app)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CHURCH_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_CHURCH_PRICE_DISPLAY=  (optional email fallback if Stripe Price retrieve fails)
# STRIPE_PRO_PRICE_DISPLAY=
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...  (optional)
# APP_URL=https://prayer.romans8.net  (checkout/portal return URLs; match VITE_APP_URL)
